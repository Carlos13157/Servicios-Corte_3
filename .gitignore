# Archivos y carpetas generados por Unity
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Mm]emoryCaptures/
UserSettings/
.wlt

# Auto-generated VS/JetBrains Rider files
.vscode/
.idea/
*.sln
*.csproj
*.pidb
*.user
*.booproj
*.svd

# Archivos de configuración específicos de OS
.DS_Store
Thumbs.db

# Archivos de paquetes Unity generados
*.unitypackage

# Archivos de compilación temporales
*.apk
*.aab
*.app
*.xcworkspace/
*.xcuserstate

# Evitar subir el Burst cache
**/BurstCache/

# Evitar subir el contenido de Builds, especialmente si está dentro del proyecto
Builds/
Builds/*

# Evitar carpetas de depuración y análisis
CrashReports/
Diagnostics/

# Archivos de configuración del sistema
*.log
*.bak
*.swp

# Git files que no queremos que causen conflictos
*.orig

# Opcional: ignora carpetas del paquete de pruebas de Unity
GeneratedTests/
